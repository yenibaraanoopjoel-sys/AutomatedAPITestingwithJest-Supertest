{
  "name": "automated-api-testing",
  "version": "1.0.0",
  "description": "Automated integration tests for authentication routes using Jest and Supertest",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node node_modules/jest/bin/jest.js --detectOpenHandles --forceExit",
    "test:watch": "node node_modules/jest/bin/jest.js --watch"
  },
  "keywords": [
    "jest",
    "supertest",
    "integration-tests",
    "authentication"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "mongoose": "^7.0.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^29.5.0",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ]
  }
}
